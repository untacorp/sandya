{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sandya",
  "version": "0.1.0-alpha.1",
  "identifier": "id.sandya.app",
  "build": {
  "frontendDist": "../out",
  "devUrl": "http://localhost:3000",
  "beforeDevCommand": "pnpm dev",
  "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
  "windows": [
  {
  "title": "Sandya — Platform Tanggap Darurat Bencana",
  "width": 1024,
  "height": 720,
  "minWidth": 360,
  "minHeight": 540,
  "resizable": true,
  "fullscreen": false
  }
  ],
  "security": {
  "csp": null
  }
  },
  "bundle": {
  "active": true,
  "category": "PublicSafety",
  "shortDescription": "Sistem Operasi Tanggap Darurat Bencana Mandiri & Offline Mesh",
  "longDescription": "Sandya adalah platform manajemen operasi tanggap darurat bencana offline-first untuk pendataan pengungsi, triase medis lapangan, logistik gudang posko, temu keluarga terpisah, dan komunikasi taktis PTT.",
  "copyright": "Copyright 2026 Sandya Humanitarian Project. All rights reserved.",
  "publisher": "Sandya Humanitarian Project",
  "targets": "all",
  "icon": [
  "icons/32x32.png",
  "icons/128x128.png",
  "icons/128x128@2x.png",
  "icons/icon.icns",
  "icons/icon.ico"
  ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "frameworks": ["CoreBluetooth"],
      "infoPlist": "Info.ios.plist"
    }
  }
}
